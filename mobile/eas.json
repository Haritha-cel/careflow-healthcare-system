{
  "cli": {
    "version": ">= 18.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"  
      },
      "env": {
        "GOOGLE_SERVICES_JSON": "mobile/google-services.json",
        "EXPO_PUBLIC_API_URL": "https://careflow-healthcare-system.onrender.com",  
        "EXPO_PUBLIC_SOCKET_URL": "https://careflow-socket.onrender.com" 
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://careflow-healthcare-system.onrender.com",  
        "EXPO_PUBLIC_SOCKET_URL": "https://careflow-socket.onrender.com" 
      }
    }
  },
  "submit": {
    "production": {}
  }
}