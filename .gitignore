# ==========================================
# ⚙️ BACKEND (Spring Boot / Java)
# ==========================================
# Build
backend/target/
backend/build/
backend/.mvn/wrapper/maven-wrapper.jar

# Env Files
backend/.env
backend/.env.*

# SECURITY NOTE: 
# If your application.yml contains plain-text passwords/keys, IGNORE it:
# backend/src/main/resources/application.yml
# If it only uses environment variables (${DB_URL}), you CAN commit it safely.